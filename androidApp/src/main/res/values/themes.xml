<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark window shown before Compose draws, so launch never flashes white. -->
    <style name="Theme.Ogh" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launcher_background</item>
        <item name="android:colorBackground">@color/launcher_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
